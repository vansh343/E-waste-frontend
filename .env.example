# Backend base URL, e.g. the Render deployment.
#
# Set   -> the browser calls the backend DIRECTLY (cross-origin). Credentials
#           are sent, so the backend must allow this origin via CORS and must
#           issue SameSite=None; Secure cookies.
# Empty -> requests stay relative and are resolved by the Vite dev proxy in
#           vite.config.js (same-origin, no CORS, cookie stays SameSite=Lax).
VITE_API_BASE_URL=https://e-waste-1-3ywr.onrender.com
